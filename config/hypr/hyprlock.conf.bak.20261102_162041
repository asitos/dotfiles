# GENERAL
general {
    hide_cursor = true
    immediate_render = true
    text_trim = false
}

# BACKGROUND (Omori with blur)
background {
    monitor =
    path = ~/Downloads/wallpapers/omori.jpg
    color = rgb(0, 0, 0)
    blur_passes = 1
    contrast = 0.8916
    brightness = 0.8172
    vibrancy = 0.8916
    vibrancy_darkness = 0.0
}

# BIG CLOCK (Ly Big Clock)
label {
    monitor =
    text = cmd[update:1000] ~/.config/Scripts/bigclock.sh
    color = rgb(180, 190, 254)
    font_size = 13
    font_family = Terminess Nerd Font Mono
    position = 0, 210
    halign = center
    valign = center
}

# DATE
label {
    monitor =
    text = cmd[update:1000] date +"%A, %B %d"
    color = rgb(166, 173, 200)
    font_size = 11
    font_family = Terminess Nerd Font Mono
    position = 0, 140
    halign = center
    valign = center
}

# MAIN LY TUI BOX (Clean, no hyprland/tty text, exact 51-char alignment)
label {
    monitor =
    text = cmd[update:10000000] echo -e "┌─ hi asitos :3 ──────────────────────────────────┐\n│                                                 │\n│  login:    asitos                               │\n│  password:                                      │\n│                                                 │\n└─────────────────────────────────────────────────┘"
    color = rgb(205, 214, 244)
    font_size = 14
    font_family = Terminess Nerd Font Mono
    position = 0, -20
    halign = center
    valign = center
}

# INLINE PASSWORD INPUT (No pill box, pure terminal typing)
input-field {
    monitor =
    size = 310, 24
    outline_thickness = 0
    dots_size = 0.22
    dots_spacing = 0.2
    dots_center = false
    dots_text_format = *
    dots_rounding = 0
    outer_color = rgba(0, 0, 0, 0)
    inner_color = rgba(0, 0, 0, 0)
    font_color = rgb(205, 214, 244)
    font_family = Terminess Nerd Font Mono
    fade_on_empty = false
    placeholder_text =
    hide_input = false
    rounding = 0
    check_color = rgba(0, 0, 0, 0)
    fail_color = rgba(0, 0, 0, 0)
    fail_text =
    position = 43, -31
    halign = center
    valign = center
}

# AUTHENTICATION FAILURE MESSAGE
label {
    monitor =
    text = $FAIL
    color = rgb(243, 139, 168)
    font_size = 11
    font_family = Terminess Nerd Font Mono
    position = 0, -100
    halign = center
    valign = center
}

# FOOTER HOTKEYS (Ly status bar)
label {
    monitor =
    text = F1 shutdown   F2 reboot
    color = rgb(108, 112, 134)
    font_size = 11
    font_family = Terminess Nerd Font Mono
    position = 0, -125
    halign = center
    valign = center
}

# MEDIA PLAYER (Bottom Ly TUI box)
label {
    monitor =
    text = cmd[update:1000] ~/.config/Scripts/hyprlock-media.sh
    color = rgb(180, 190, 254)
    font_size = 14
    font_family = Terminess Nerd Font Mono
    position = 0, 40
    halign = center
    valign = bottom
}
