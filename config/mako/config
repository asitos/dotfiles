# Global Settings
font=Terminess Nerd Font 11
width=300
height=100
margin=10
padding=10
border-size=1
border-radius=2
max-history=50
max-visible=15
icons=1
max-icon-size=48

# Matugen Theme Colors
background-color=#140c0ce6
text-color=#f0dedd
border-color=#ffb3b1
progress-color=over #322827

# Behavior
default-timeout=3000
ignore-timeout=0
layer=overlay
anchor=top-right

# Urgency Levels
[urgency=high]
border-color=#ffb4ab
default-timeout=0

# click actions
on-button-left=invoke-default-action
on-button-right=dismiss
