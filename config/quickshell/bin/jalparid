#!/usr/bin/env bash

VERBOSE=false

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$JALPARI_DIR" ]; then
    if [ -d "$(dirname "$BIN_DIR")/scripts" ]; then
        JALPARI_DIR="$(dirname "$BIN_DIR")"
        export JALPARI_DIR
    else
        JALPARI_DIR="$(dirname "$BIN_DIR")/src"
        export JALPARI_DIR
    fi
fi

source "$JALPARI_DIR/scripts/caching.sh"
source "$JALPARI_DIR/scripts/config.sh"
source "$JALPARI_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    if [ -f "$JALPARI_DIR/Shell.qml" ]; then
        export MAIN_QML="$JALPARI_DIR/Shell.qml"
    elif [ -f "$JALPARI_DIR/quickshell/Shell.qml" ]; then
        export MAIN_QML="$JALPARI_DIR/quickshell/Shell.qml"
    else
        MAIN_QML="$(find "$JALPARI_DIR" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
        export MAIN_QML
    fi
fi

is_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    local stat
    stat=$(<"/proc/$pid/stat") 2>/dev/null || return 1
    [[ "$stat" =~ \)\ Z ]] && return 1
    return 0
}

terminate_and_wait() {
    local pid="$1"
    local timeout="${2:-2}"
    local count=0
    local max_count=$(( timeout * 20 ))

    if [ -z "$pid" ] || ! is_alive "$pid"; then
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null

    while is_alive "$pid"; do
        if [ "$count" -ge "$max_count" ]; then
            kill -KILL "$pid" 2>/dev/null
            break
        fi
        sleep 0.05
        ((count++))
    done
}

get_daemon_pid() {
    if [ -f "/tmp/jalparid.pid" ]; then
        cat "/tmp/jalparid.pid" 2>/dev/null
    fi
}

get_all_children() {
    local target="$1"
    local child
    for child in $(pgrep -P "$target" 2>/dev/null); do
        get_all_children "$child"
        echo "$child"
    done
}

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/jalpari/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^JALPARI_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$JALPARI_VERSION" ]; then
        ver="$JALPARI_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$JALPARI_DIR" ] && [ -f "$JALPARI_DIR/version.txt" ]; then
            ver=$(cat "$JALPARI_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$JALPARI_DIR" ] && [ -f "$(dirname "$JALPARI_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$JALPARI_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

show_help() {
    echo "$(t "daemon.cli.usage")"
    echo ""
    echo "$(t "daemon.cli.description")"
    echo ""
    echo "$(t "daemon.cli.commands")"
    echo "  start                       $(t "daemon.cli.cmd_start")"
    echo "  stop                        $(t "daemon.cli.cmd_stop")"
    echo "  status                      $(t "daemon.cli.cmd_status")"
    echo ""
    echo "$(t "daemon.cli.options")"
    echo "  -v, --verbose               $(t "daemon.cli.opt_verbose")"
    echo "  -V, --version               $(t "daemon.cli.opt_version")"
    echo "  -h, --help                  $(t "daemon.cli.opt_help")"
    echo ""
}

COMMAND=""
while [ $# -gt 0 ]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export JALPARI_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "jalparid v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        start|stop|status)
            if [ -z "$COMMAND" ]; then
                COMMAND="$1"
            fi
            shift
            ;;
        *)
            echo "$(t "daemon.cli.unknown_arg" ARG="$1")"
            show_help
            exit 1
            ;;
    esac
done

if [ -z "$COMMAND" ]; then
    COMMAND="start"
fi

if [ "$COMMAND" == "stop" ]; then
    pid="$(get_daemon_pid)"

    if [ -n "$pid" ] && is_alive "$pid"; then
        terminate_and_wait "$pid" 3
    fi

    pkill -TERM -f "jalpari-core screentime track" 2>/dev/null
    pkill -TERM -x quickshell 2>/dev/null
    pkill -TERM -f "quickshell.*Shell" 2>/dev/null
    sleep 0.2

    pkill -KILL -f "jalpari-core screentime track" 2>/dev/null
    pkill -KILL -f "jalpari-core watch" 2>/dev/null
    pkill -KILL -x quickshell 2>/dev/null
    pkill -KILL -f "jalpari-audio" 2>/dev/null
    pkill -TERM -f "wl-paste --watch echo 1" 2>/dev/null
    bash "$JALPARI_DIR/scripts/gamma.sh" stop >/dev/null 2>&1
    command -v jalpari-core >/dev/null 2>&1 && jalpari-core quit >/dev/null 2>&1

    rm -f "/tmp/jalparid.pid" "/tmp/jalparid.lock" 2>/dev/null
    echo "$(t "daemon.cli.stopped")"
    exit 0
fi

if [ "$COMMAND" == "status" ]; then
    pid="$(get_daemon_pid)"
    if [ -n "$pid" ] && is_alive "$pid"; then
        echo "$(t "daemon.cli.status_running" PID="$pid")"
        exit 0
    elif pgrep -x quickshell >/dev/null 2>&1; then
        echo "Quickshell is running (standalone PID $(pgrep -x quickshell | tr '\n' ' '))"
        exit 0
    else
        echo "$(t "daemon.cli.status_stopped")"
        exit 1
    fi
fi

# Hardware decoder for video wallpapers when the NVIDIA driver is loaded.
# shellcheck disable=SC2120
wallpaper_decoder() {
    local drm="${1:-/sys/class/drm}" node
    for node in "$drm"/renderD*; do
        [ -r "$node/device/vendor" ] || continue
        if [ "$(cat "$node/device/vendor")" != "0x10de" ]; then
            echo vaapi
        else
            echo none
        fi
        return
    done
    echo none
}

if [ "$COMMAND" == "start" ]; then
    exec 9>"/tmp/jalparid.lock"

    if ! flock -n 9; then
        existing_pid="$(get_daemon_pid)"

        if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
            echo "$(t "daemon.already_running")"
            exit 0
        fi

        pkill -KILL -f "jalpari-core screentime track" 2>/dev/null
        pkill -KILL -x quickshell 2>/dev/null
        sleep 0.2

        if ! flock -n 9; then
            existing_pid="$(get_daemon_pid)"
            if [ -n "$existing_pid" ] && is_alive "$existing_pid"; then
                echo "$(t "daemon.already_running")"
                exit 0
            fi
            echo "$(t "daemon.already_running")"
            exit 0
        fi
    fi

    # Ensure no lingering orphan quickshell or screentime from prior unclean session
    pkill -KILL -f "jalpari-core screentime track" 2>/dev/null
    pkill -KILL -f "jalpari-core watch" 2>/dev/null
    pkill -KILL -x quickshell 2>/dev/null
    pkill -KILL -f "jalpari-audio visualizer" 2>/dev/null
    sleep 0.1

    echo $$ > "/tmp/jalparid.pid"

    CLEANUP_DONE=false
    LAUNCH_PID=""
    QS_PID=""

    cleanup() {
        if [ "$CLEANUP_DONE" = true ]; then
            return
        fi
        CLEANUP_DONE=true
        trap '' SIGINT SIGTERM SIGHUP

        [ "$VERBOSE" = true ] && echo "$(t "daemon.shutting_down")"

        for p in "$QS_PID" "$LAUNCH_PID"; do
            [ -n "$p" ] && kill -TERM "$p" 2>/dev/null
            [ -n "$p" ] && kill -TERM -- "-$p" 2>/dev/null
        done
        pkill -TERM -f "jalpari-core screentime track" 2>/dev/null
        pkill -TERM -x quickshell 2>/dev/null

        local count=0
        while [ "$count" -lt 20 ]; do
            if ! is_alive "$QS_PID" && ! is_alive "$LAUNCH_PID" && ! pgrep -x quickshell >/dev/null 2>&1; then
                break
            fi
            sleep 0.05
            ((count++))
        done

        for p in "$QS_PID" "$LAUNCH_PID"; do
            [ -n "$p" ] && kill -KILL "$p" 2>/dev/null
            [ -n "$p" ] && kill -KILL -- "-$p" 2>/dev/null
        done
        pkill -KILL -f "jalpari-core screentime track" 2>/dev/null
        pkill -KILL -f "jalpari-core watch" 2>/dev/null
        pkill -KILL -x quickshell 2>/dev/null
        pkill -KILL -f "jalpari-audio" 2>/dev/null
        bash "$JALPARI_DIR/scripts/gamma.sh" stop 9>&- >/dev/null 2>&1
        command -v jalpari-core >/dev/null 2>&1 && jalpari-core quit 9>&- >/dev/null 2>&1

        exec 9>&- 2>/dev/null
        rm -f "/tmp/jalparid.pid" "/tmp/jalparid.lock" 2>/dev/null
        exit 0
    }

    trap cleanup SIGINT SIGTERM SIGHUP EXIT

    [ "$VERBOSE" = true ] && echo "$(t "daemon.launching")"

    (
        if command -v jalpari-audio >/dev/null 2>&1; then
            jalpari-audio start
        fi
    ) 9>&- >/dev/null 2>&1 &

    if command -v jalpari-core >/dev/null 2>&1; then
        if ! pgrep -f "jalpari-core screentime track" >/dev/null 2>&1; then
            jalpari-core screentime track 9>&- >/dev/null 2>&1 &
            LAUNCH_PID=$!
        fi
    fi

    if [ -d /proc/driver/nvidia ]; then
        export QT_FFMPEG_DECODING_HW_DEVICE_TYPES="${QT_FFMPEG_DECODING_HW_DEVICE_TYPES-$(wallpaper_decoder)}"
    fi
    quickshell -n -p "$MAIN_QML" 9>&- &
    QS_PID=$!

    while kill -0 "$QS_PID" 2>/dev/null; do
        wait "$QS_PID" 2>/dev/null
    done
fi
