#!/usr/bin/env bash

BIN_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
if [ -z "$JALPARI_DIR" ]; then
    if [ -d "$(dirname "$BIN_DIR")/scripts" ]; then
        export JALPARI_DIR="$(dirname "$BIN_DIR")"
    else
        export JALPARI_DIR="$(dirname "$BIN_DIR")/src"
    fi
fi

source "$JALPARI_DIR/scripts/caching.sh"
source "$JALPARI_DIR/scripts/config.sh"
source "$JALPARI_DIR/scripts/i18n.sh"

if [ -z "$MAIN_QML" ]; then
    if [ -f "$JALPARI_DIR/Shell.qml" ]; then
        export MAIN_QML="$JALPARI_DIR/Shell.qml"
    elif [ -f "$JALPARI_DIR/quickshell/Shell.qml" ]; then
        export MAIN_QML="$JALPARI_DIR/quickshell/Shell.qml"
    else
        export MAIN_QML="$(find "$JALPARI_DIR" -type f \( -name "Shell.qml" -o -name "Bar.qml" \) 2>/dev/null | head -n 1)"
    fi
fi

is_alive() {
    local pid="$1"
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    local stat
    stat=$(<"/proc/$pid/stat") 2>/dev/null || return 1
    [[ "$stat" =~ \)\ Z ]] && return 1
    return 0
}

terminate_and_wait() {
    local pid="$1"
    local timeout="${2:-2}"
    local count=0
    local max_count=$(( timeout * 20 ))

    if [ -z "$pid" ] || ! is_alive "$pid"; then
        return 0
    fi

    kill -TERM "$pid" 2>/dev/null

    while is_alive "$pid"; do
        if [ "$count" -ge "$max_count" ]; then
            kill -KILL "$pid" 2>/dev/null
            break
        fi
        sleep 0.05
        ((count++))
    done
}

get_daemon_pid() {
    if [ -f "/tmp/jalparid.pid" ]; then
        cat "/tmp/jalparid.pid" 2>/dev/null
    fi
}

get_installed_version() {
    local version_file="${XDG_STATE_HOME:-$HOME/.local/state}/jalpari/version"
    local ver=""
    if [ -f "$version_file" ]; then
        ver=$(awk -F= '/^JALPARI_VERSION=/{gsub(/["'\'' ]/, "", $2); print $2}' "$version_file")
    fi
    if [ -z "$ver" ] && [ -n "$JALPARI_VERSION" ]; then
        ver="$JALPARI_VERSION"
    fi
    if [ -z "$ver" ]; then
        if [ -n "$JALPARI_DIR" ] && [ -f "$JALPARI_DIR/version.txt" ]; then
            ver=$(cat "$JALPARI_DIR/version.txt" 2>/dev/null | xargs)
        elif [ -f "$(dirname "$BIN_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$BIN_DIR")/version.txt" 2>/dev/null | xargs)
        elif [ -n "$JALPARI_DIR" ] && [ -f "$(dirname "$JALPARI_DIR")/version.txt" ]; then
            ver=$(cat "$(dirname "$JALPARI_DIR")/version.txt" 2>/dev/null | xargs)
        fi
    fi
    if [ -z "$ver" ]; then
        ver="2.0.0"
    fi
    echo "$ver"
}

ensure_daemon() {
    local pid="$(get_daemon_pid)"

    if [ -n "$pid" ] && is_alive "$pid"; then
        return 0
    fi

    if pgrep -x quickshell >/dev/null 2>&1 || pgrep -f "quickshell.*Shell\.qml" >/dev/null 2>&1; then
        return 0
    fi

    rm -f "/tmp/jalparid.pid" "/tmp/jalparid.lock" 2>/dev/null

    [ "$VERBOSE" = true ] && echo "$(t "cli.starting_daemon")"
    local daemon_bin="$BIN_DIR/jalparid"
    setsid "$daemon_bin" start > /dev/null 2>&1 &

    local count=0
    while [ "$count" -lt 25 ]; do
        local cur_pid="$(get_daemon_pid)"
        if [ -n "$cur_pid" ] && is_alive "$cur_pid"; then
            break
        fi
        if pgrep -x quickshell >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
        ((count++))
    done
}

stop_daemon() {
    local pid="$(get_daemon_pid)"

    if [ -n "$pid" ] && is_alive "$pid"; then
        terminate_and_wait "$pid" 3
    fi

    pkill -TERM -f "jalpari-core screentime track" 2>/dev/null
    pkill -TERM -x quickshell 2>/dev/null
    sleep 0.2

    pkill -KILL -f "jalpari-core screentime track" 2>/dev/null
    pkill -KILL -f "jalpari-core watch" 2>/dev/null
    pkill -KILL -x quickshell 2>/dev/null
    pkill -KILL -f "jalpari-audio" 2>/dev/null
    bash "$JALPARI_DIR/scripts/gamma.sh" stop >/dev/null 2>&1
    command -v jalpari-core >/dev/null 2>&1 && jalpari-core quit >/dev/null 2>&1

    rm -f "/tmp/jalparid.pid" "/tmp/jalparid.lock" 2>/dev/null
}

restart_daemon() {
    stop_daemon
    ensure_daemon
    echo "$(t "cli.daemon_restarted")"
}

cli_usage() {
    echo "Usage: jalpari $*" >&2
    exit 1
}

cli_ipc() {
    ensure_daemon
    quickshell -p "$MAIN_QML" ipc call "$@"
}

cli_cfg_apply() {
    local filter="$1"
    shift
    _config_ensure_settings
    local tmp="${CONFIG_SETTINGS_JSON}.tmp"
    if jq "$@" "$filter" "$CONFIG_SETTINGS_JSON" > "$tmp" 2>/dev/null && jq . "$tmp" >/dev/null 2>&1; then
        mv "$tmp" "$CONFIG_SETTINGS_JSON"
    else
        rm -f "$tmp"
        return 1
    fi
}

cli_cfg_get() {
    _config_ensure_settings
    jq -r --arg p "$1" --arg f "${2:-}" \
        '(try getpath($p | split(".")) catch null) as $v | if $v == null then $f elif ($v | type) == "string" then $v else ($v | tojson) end' \
        "$CONFIG_SETTINGS_JSON"
}

cli_cfg_set() {
    local value
    if [ -n "$2" ] && printf '%s' "$2" | jq . >/dev/null 2>&1; then
        value="$2"
    else
        value="$(jq -Rn --arg v "$2" '$v')"
    fi
    cli_cfg_apply 'setpath($p | split("."); $v)' --arg p "$1" --argjson v "$value"
}

cli_config() {
    local sub="${1:-}"
    shift 2>/dev/null || true
    case "$sub" in
        get)
            [ -n "$1" ] || cli_usage "config get <key> [fallback]"
            cli_cfg_get "$1" "${2:-}"
            ;;
        set)
            [ $# -ge 2 ] || cli_usage "config set <key> <value>"
            cli_cfg_set "$1" "$2"
            ;;
        dump)
            _config_ensure_settings
            jq . "$CONFIG_SETTINGS_JSON"
            ;;
        path)
            _config_ensure_settings
            echo "$CONFIG_SETTINGS_JSON"
            ;;
        edit)
            _config_ensure_settings
            local -a editor
            read -ra editor <<< "${VISUAL:-${EDITOR:-vi}}"
            "${editor[@]}" "$CONFIG_SETTINGS_JSON"
            ;;
        *)
            cli_usage "config <get <key>|set <key> <value>|dump|path|edit|gui>"
            ;;
    esac
}

cli_switch() {
    local path="$1"
    local action="${2:-toggle}"
    local default="$3"
    local label="$4"
    local current new
    current="$(cli_cfg_get "$path" "$default")"

    case "$action" in
        on) new=true ;;
        off) new=false ;;
        toggle) [ "$current" = "true" ] && new=false || new=true ;;
        status) new="$current" ;;
        *) cli_usage "$label <on|off|toggle|status>" ;;
    esac

    if [[ "$action" != "status" ]]; then
        cli_cfg_set "$path" "$new"
    fi

    [ "$new" = "true" ] && echo "$(t "cli.state_on")" || echo "$(t "cli.state_off")"
}

cli_wallpaper_files() {
    local dir
    dir="$(cli_cfg_get wallpaperDir "")"
    [ -n "$dir" ] || dir="$(cli_cfg_get wallpaper_dir "")"
    [ -n "$dir" ] || dir="${WALLPAPER_DIR:-$HOME/Pictures/Wallpapers}"
    [ -d "$dir" ] || return 0
    find -L "$dir" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.jpeg" -o -iname "*.png" -o -iname "*.webp" -o -iname "*.gif" -o -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.mov" -o -iname "*.webm" \) | sort
}

cli_theme_find() {
    local file name
    for file in "$JALPARI_DIR"/assets/themes/*.json; do
        name="$(basename "$file" .json)"
        if [[ "${name,,}" == "${1,,}" ]]; then
            echo "$file"
            return 0
        fi
    done
    return 1
}

cli_monitors() {
    local core_cmd="jalpari-core"

    if [[ "$1" == "--json" ]]; then
        if [ -n "$core_cmd" ]; then
            $core_cmd monitors | jq '[.[] | {name, width, height, refreshRate}]'
        elif command -v hyprctl >/dev/null 2>&1; then
            hyprctl monitors -j | jq '[.[] | {name, width, height, refreshRate: .refreshRate}]'
        else
            echo "[]"
        fi
    else
        if [ -n "$core_cmd" ]; then
            $core_cmd monitors | jq -r '.[].name'
        elif command -v hyprctl >/dev/null 2>&1; then
            hyprctl monitors -j | jq -r '.[].name'
        fi
    fi
}

cli_caffeine() {
    cli_switch idle.manualInhibit "$1" false "set idle caffeine"
    if [[ "${1:-toggle}" != "status" && "$(cli_cfg_get idle.manualInhibit false)" != "true" ]]; then
        cli_cfg_apply '.idle = ((.idle // {}) + {caffeineStartTime: 0, caffeineEndTime: 0})'
    fi
}

cli_matugen() {
    local current mode
    current="$(cli_cfg_get theme.matugen true)"
    case "${1:-toggle}" in
        on) mode=true ;;
        off) mode=false ;;
        toggle) [ "$current" = "true" ] && mode=false || mode=true ;;
        *) cli_usage "theme matugen [on|off|toggle]" ;;
    esac
    if [ "$mode" = true ]; then
        cli_cfg_apply '.theme = ((.theme // {}) + {activePreset: "Matugen", matugen: true})'
        cli_ipc matugen generateImage "$(cli_ipc wallpaper getWallpaperPath "")"
    else
        cli_cfg_apply '.theme = ((.theme // {}) + {matugen: false})'
    fi
    cli_ipc theme reloadColors
}

cli_set_theme() {
    local file name colors mode
    [ -n "$1" ] || cli_usage "theme preset <name>"
    if ! file="$(cli_theme_find "$1")"; then
        echo "$(t "cli.error_unknown_theme" NAME="$1")" >&2
        exit 1
    fi
    name="$(jq -r '.name // empty' "$file")"
    [ -n "$name" ] || name="$(basename "$file" .json)"
    colors="$(jq -c '.colors' "$file")"
    mode="$(cli_cfg_get theme.mode dark)"
    cli_cfg_apply '.theme = ((.theme // {}) + {activePreset: $n, matugen: false, colors: $c})' --arg n "$name" --argjson c "$colors"
    cli_ipc matugen generateFromStatic "$colors" "$mode"
    cli_ipc theme reloadColors
}

cli_app_theme() {
    local id="$1" listing current next enabled
    local engine="$JALPARI_DIR/scripts/theming/apptheme.py"
    [ -n "$id" ] || cli_usage "theme app <id> [on|off|toggle]"
    export QS_STATE_DIR="${QS_STATE_DIR:-"${XDG_STATE_HOME:-$HOME/.local/state}/jalpari"}"
    export QS_SETTINGS="$CONFIG_SETTINGS_JSON"
    listing="$(python3 "$engine" list)" || exit 1
    if ! jq -e --arg i "$id" '.apps | any(.id == $i)' <<< "$listing" >/dev/null; then
        echo "$(t "cli.error_unknown_app" ID="$id")" >&2
        exit 1
    fi
    current="$(jq -r --arg i "$id" '.apps[] | select(.id == $i) | .enabled' <<< "$listing")"
    case "${2:-toggle}" in
        on) next=true ;;
        off) next=false ;;
        toggle) [ "$current" = "true" ] && next=false || next=true ;;
        *) cli_usage "theme app <id> [on|off|toggle]" ;;
    esac
    enabled="$(jq -c --arg i "$id" --argjson on "$next" '[.apps[] | select(.enabled and .id != $i) | .id] + (if $on then [$i] else [] end) | sort' <<< "$listing")"
    cli_cfg_apply '.theme = ((.theme // {}) + {apps: $a})' --argjson a "$enabled"
    python3 "$engine" apply --enabled="$(jq -r 'join(",")' <<< "$enabled")" >/dev/null || true
}

cli_set_lang() {
    [ -n "$1" ] || cli_usage "set lang <code>"
    if [ ! -f "$I18N_DIR/$1.json" ]; then
        echo "$(t "cli.error_unknown_language" CODE="$1")" >&2
        exit 1
    fi
    cli_cfg_set general.language "$1"
}

cli_set_wallpaper() {
    local value="${1:-}"
    local screen="${2:-all}"
    local target current files
    case "$value" in
        "")
            cli_usage "theme wallpaper <path|random|next|prev|play|pause|clear> [screen]"
            ;;
        random|next|prev)
            files="$(cli_wallpaper_files)"
            if [ -z "$files" ]; then
                echo "$(t "cli.error_no_wallpapers")" >&2
                exit 1
            fi
            if [[ "$value" == "random" ]]; then
                target="$(shuf -n 1 <<< "$files")"
            else
                current="$(cli_ipc wallpaper getWallpaperPath "$([ "$screen" = all ] && echo "" || echo "$screen")")"
                target="$(awk -v cur="$current" -v dir="$value" '
                    function base(p,  a, n) { n = split(p, a, "/"); return a[n] }
                    { f[NR] = $0; if (base($0) == base(cur)) idx = NR }
                    END {
                        if (!idx) { print ((dir == "next") ? f[1] : f[NR]); exit }
                        print f[(dir == "next") ? idx % NR + 1 : (idx + NR - 2) % NR + 1]
                    }' <<< "$files")"
            fi
            cli_ipc wallpaper setWallpaper "$screen" "$target" ""
            ;;
        play|pause)
            cli_ipc wallpaper setPlayback "$screen" "$value"
            ;;
        clear)
            cli_ipc wallpaper clearWallpaper "$screen"
            ;;
        *)
            if [ ! -f "$value" ]; then
                echo "$(t "cli.error_file_not_found" PATH="$value")" >&2
                exit 1
            fi
            cli_ipc wallpaper setWallpaper "$screen" "$(realpath "$value")" "${3:-}"
            ;;
    esac
}

cli_settings_json() {
    _config_ensure_settings
    jq -c "$@" "$CONFIG_SETTINGS_JSON"
}

cli_list_json() {
    local file
    for file in "$@"; do
        [ -f "$file" ] && basename "$file" .json
    done | jq -Rsc 'split("\n") | map(select(length > 0))'
}

cli_info_group() {
    local json
    case "$1" in
        notifications) json="$(cli_settings_json '{dnd: (.notifications.dnd == true)}')" ;;
        idle) json="$(cli_ipc idle status)" ;;
        dock) json="$(cli_settings_json '{enabled: (.dock.enabled != false), autohide: (.dock.autohide == true)}')" ;;
        sfx) json="$(cli_settings_json '{mute: (.general.muteSfx == true)}')" ;;
        theme)
            json="$(cli_settings_json --argjson p "$(cli_list_json "$JALPARI_DIR"/assets/themes/*.json)" \
                '{preset: (.theme.activePreset // "Matugen"), matugen: (.theme.matugen != false), apps: (.theme.apps // ["cava", "gtk", "kitty", "qt"]), presets: $p}')"
            ;;
        lang)
            json="$(jq -nc --arg c "$(get_current_language)" --argjson a "$(cli_list_json "$I18N_DIR"/*.json)" \
                '{current: $c, available: $a}')"
            ;;
    esac
    if [ -z "$2" ]; then
        jq . <<< "$json"
    elif jq -e --arg k "$2" 'has($k)' <<< "$json" >/dev/null 2>&1; then
        jq -r --arg k "$2" '.[$k] | if type == "array" then .[] else . end' <<< "$json"
    else
        cli_usage "info $1 [$(jq -r 'keys_unsorted | join("|")' <<< "$json")]"
    fi
}

cli_info() {
    local topic="${1:-}"
    case "$topic" in
        notifications|idle|dock|sfx|theme|lang) cli_info_group "$topic" "${2:-}" ;;
        wallpaper) cli_ipc wallpaper getWallpaperPath "${2:-}" ;;
        monitors) cli_monitors "$2" ;;
        *) cli_usage "info <notifications|idle|dock|sfx|theme|lang|wallpaper|monitors>" ;;
    esac
}

cli_set() {
    local group="${1:-}" key="${2:-}"
    case "$group" in
        notifications)
            case "$key" in
                dnd) cli_switch notifications.dnd "$3" false "set notifications dnd" ;;
                *) cli_usage "set notifications dnd [on|off|toggle]" ;;
            esac
            ;;
        idle)
            case "$key" in
                caffeine) cli_caffeine "$3" ;;
                *) cli_usage "set idle caffeine [on|off|toggle]" ;;
            esac
            ;;
        dock)
            case "$key" in
                enabled) cli_switch dock.enabled "$3" true "set dock enabled" ;;
                autohide) cli_switch dock.autohide "$3" false "set dock autohide" ;;
                *) cli_usage "set dock <enabled|autohide> [on|off|toggle]" ;;
            esac
            ;;
        sfx)
            case "$key" in
                mute) cli_switch general.muteSfx "$3" false "set sfx mute" ;;
                *) cli_usage "set sfx mute [on|off|toggle]" ;;
            esac
            ;;
        theme)
            case "$key" in
                preset) cli_set_theme "$3" ;;
                matugen) cli_matugen "$3" ;;
                app) cli_app_theme "$3" "$4" ;;
                *) cli_usage "set theme <preset <name>|matugen [on|off|toggle]|app <id> [on|off|toggle]>" ;;
            esac
            ;;
        lang) cli_set_lang "$2" ;;
        wallpaper)
            shift
            cli_set_wallpaper "$@"
            ;;
        *) cli_usage "set <notifications dnd|idle caffeine|dock <enabled|autohide>|sfx mute> [on|off|toggle] | set theme <preset <name>|matugen [on|off|toggle]|app <id> [on|off|toggle]> | set lang <code> | set wallpaper <value> [screen]" ;;
    esac
}

cli_trigger() {
    case "${1:-}" in
        idle)
            case "${2:-}" in
                dim|dpms|lock|suspend) cli_ipc idle trigger "$2" ;;
                *) cli_usage "trigger idle <dim|dpms|lock|suspend>" ;;
            esac
            ;;
        notifications)
            case "${2:-}" in
                clear) cli_ipc main clearNotifications ;;
                *) cli_usage "trigger notifications clear" ;;
            esac
            ;;
        theme)
            case "${2:-}" in
                reload) cli_ipc theme reloadColors ;;
                generate)
                    [ -n "$3" ] || cli_usage "trigger theme generate <image> [mode] [scheme]"
                    if [ ! -f "$3" ]; then
                        echo "$(t "cli.error_file_not_found" PATH="$3")" >&2
                        exit 1
                    fi
                    cli_ipc matugen generate "$(realpath "$3")" "${4:-}" "${5:-}"
                    ;;
                *) cli_usage "trigger theme <reload|generate <image> [mode] [scheme]>" ;;
            esac
            ;;
        *)
            cli_usage "trigger <idle <dim|dpms|lock|suspend>|notifications clear|theme <reload|generate <image> [mode] [scheme]>>"
            ;;
    esac
}

# ==============================================================================
# STRUCTURED OBJECT COMMAND HANDLERS (iproute2-style grammar: <object> <command>)
# ==============================================================================

obj_daemon() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        restart) restart_daemon ;;
        stop|kill)
            stop_daemon
            echo "$(t "cli.daemon_stopped")"
            ;;
        status)
            local dbin="$BIN_DIR/jalparid"
            exec "$dbin" status "$@"
            ;;
        reload)
            exec "$JALPARI_DIR/scripts/reload.sh" "$@"
            ;;
        start)
            ensure_daemon
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari daemon <command>

Commands:
  restart     Stop and start the daemon
  stop        Stop the running daemon
  status      Show current daemon status
  reload      Force reload quickshell desktop elements
  start       Start daemon if not running
EOF
            ;;
        *)
            echo "Error: unknown daemon command '$cmd'." >&2
            exit 1
            ;;
    esac
}

obj_ui() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        toggle|open|close|workspace|bar)
            ensure_daemon
            exec "$JALPARI_DIR/scripts/qs_manager.sh" "$cmd" "$@"
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari ui <command> [arguments...]

Commands:
  toggle <panel>           Toggle UI panel (launcher, clipboard, network, volume, music, quickactions)
  open <panel>             Open UI panel
  close                    Close active shell overlay
  workspace <num> [move]   Switch to workspace (append 'move' to send active window)
  bar <autohide|show|hide> Control bar visibility
EOF
            ;;
        *)
            ensure_daemon
            exec "$JALPARI_DIR/scripts/qs_manager.sh" "$cmd" "$@"
            ;;
    esac
}

obj_system() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        lock) exec "$JALPARI_DIR/scripts/lock.sh" "$@" ;;
        exit) exec "$JALPARI_DIR/scripts/system/exit.sh" "$@" ;;
        suspend|sleep) exec "$JALPARI_DIR/scripts/system/suspend.sh" "$@" ;;
        hibernate) exec "$JALPARI_DIR/scripts/system/hibernate.sh" "$@" ;;
        reboot) exec "$JALPARI_DIR/scripts/system/reboot.sh" "$@" ;;
        poweroff) exec "$JALPARI_DIR/scripts/system/poweroff.sh" "$@" ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari system <command>

Commands:
  lock        Activate lockscreen
  exit        Terminate session and compositor
  suspend     Lock screen and suspend system
  hibernate   Hibernate system
  reboot      Reboot system
  poweroff    Power off system
EOF
            ;;
        *)
            echo "Error: unknown system command '$cmd'." >&2
            exit 1
            ;;
    esac
}

obj_audio() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        volume)
            exec "$JALPARI_DIR/scripts/volume.sh" "$@"
            ;;
        mute)
            exec "$JALPARI_DIR/scripts/volume.sh" "mute-toggle" "$@"
            ;;
        mic)
            local sub="${1:-toggle}"
            shift 2>/dev/null || true
            case "$sub" in
                toggle) exec "$JALPARI_DIR/scripts/volume.sh" "mic-toggle" "$@" ;;
                raise) exec "$JALPARI_DIR/scripts/volume.sh" "mic-raise" "$@" ;;
                lower) exec "$JALPARI_DIR/scripts/volume.sh" "mic-lower" "$@" ;;
                *) exec "$JALPARI_DIR/scripts/volume.sh" "mic-$sub" "$@" ;;
            esac
            ;;
        raise|lower|mute-toggle|mic-toggle|mic-raise|mic-lower)
            exec "$JALPARI_DIR/scripts/volume.sh" "$cmd" "$@"
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari audio <command> [arguments...]

Commands:
  volume raise | lower     Adjust output volume (+5% / -5%)
  mute                     Toggle output mute
  mic toggle | raise | lower Adjust microphone volume & mute
EOF
            ;;
        *)
            echo "Error: unknown audio command '$cmd'." >&2
            exit 1
            ;;
    esac
}

obj_display() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        brightness)
            if [ -z "$1" ]; then
                if command -v jalpari-core >/dev/null 2>&1; then
                    exec jalpari-core brightness get
                elif command -v brightnessctl >/dev/null 2>&1; then
                    exec brightnessctl -m | cut -d, -f4 | tr -d '%'
                fi
            elif [ "$1" = "get" ]; then
                shift
                if command -v jalpari-core >/dev/null 2>&1; then
                    exec jalpari-core brightness get "$@"
                elif command -v brightnessctl >/dev/null 2>&1; then
                    exec brightnessctl -m | cut -d, -f4 | tr -d '%'
                fi
            elif [ "$1" = "set" ]; then
                shift
                if command -v jalpari-core >/dev/null 2>&1; then
                    exec jalpari-core brightness set "$@"
                elif command -v brightnessctl >/dev/null 2>&1; then
                    exec brightnessctl s "$@"
                fi
            else
                if command -v jalpari-core >/dev/null 2>&1; then
                    exec jalpari-core brightness "$1"
                elif command -v brightnessctl >/dev/null 2>&1; then
                    exec brightnessctl s "$1%"
                fi
            fi
            ;;
        gamma)
            exec "$JALPARI_DIR/scripts/gamma.sh" "$@"
            ;;
        monitors)
            cli_monitors "$@"
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari display <command> [arguments...]

Commands:
  brightness [get|set <value>]   Query or adjust display backlight
  gamma <set|auto|reset|status>  Adjust blue light temperature and day/night schedule
  monitors [--json]              List connected display monitors
EOF
            ;;
        *)
            echo "Error: unknown display command '$cmd'." >&2
            exit 1
            ;;
    esac
}

obj_theme() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        preset)
            if [ -n "$1" ]; then
                cli_set_theme "$1"
            else
                cli_info_group theme preset
            fi
            ;;
        matugen)
            cli_matugen "$@"
            ;;
        app)
            cli_app_theme "$@"
            ;;
        wallpaper)
            cli_set_wallpaper "$@"
            ;;
        reload)
            cli_ipc theme reloadColors
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari theme <command> [arguments...]

Commands:
  preset [name]                  Apply or query active theme preset
  matugen [on|off|toggle]        Toggle dynamic Matugen wallpaper theming
  app <id> [on|off|toggle]       Enable or disable theming for specific app
  wallpaper <path|next|prev>     Change wallpaper image
  reload                         Reload current theme colors
EOF
            ;;
        *)
            echo "Error: unknown theme command '$cmd'." >&2
            exit 1
            ;;
    esac
}

obj_config() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        get|set|dump|path|edit)
            cli_config "$cmd" "$@"
            ;;
        gui|settings)
            exec "$JALPARI_DIR/scripts/settings.sh" "$@"
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari config <command> [arguments...]

Commands:
  get <key> [fallback]   Read configuration key
  set <key> <value>      Set configuration key
  dump                   Dump full configuration JSON
  path                   Print path to configuration file
  edit                   Open configuration in $EDITOR
  gui [tab]              Open settings window (GUI)
EOF
            ;;
        *)
            cli_config "$cmd" "$@"
            ;;
    esac
}

obj_env() {
    local cmd="${1:-}"
    shift 2>/dev/null || true
    case "$cmd" in
        weather)
            exec "$JALPARI_DIR/scripts/weather.sh" "$@"
            ;;
        location)
            if [ "$1" = "set" ]; then
                shift
                exec "$JALPARI_DIR/scripts/location_manual.sh" "$@"
            else
                exec "$JALPARI_DIR/scripts/location.sh" "$@"
            fi
            ;;
        -h|--help|"")
            cat << 'EOF'
Usage: jalpari env <command> [arguments...]

Commands:
  weather [--json|--current-temp]   Query weather forecast data
  location [refresh]                Update geographic coordinates via IP
  location set <lat> <lon>          Set manual coordinates & timezone
EOF
            ;;
        *)
            echo "Error: unknown env command '$cmd'." >&2
            exit 1
            ;;
    esac
}

show_help() {
    cat << 'EOF'
Usage: jalpari <object> <command> [arguments...]
       jalpari [options...]

Objects:
  daemon      manage shell daemon (restart, stop, status, reload)
  ui          control UI overlays & workspaces (toggle, open, close, workspace)
  system      power & session controls (lock, exit, suspend, reboot, poweroff)
  audio       audio volume & controls (volume, mute, mic)
  display     brightness, night light & monitors (brightness, gamma, monitors)
  theme       theming & wallpaper (preset, matugen, wallpaper, reload)
  config      settings & configuration (get, set, dump, edit, gui)
  env         environment feeds (weather, location)

Options:
  -v, --verbose    Enable verbose logging
  -V, --version    Display version
  -h, --help       Show this help

Examples:
  jalpari daemon restart
  jalpari ui toggle launcher
  jalpari audio volume raise
  jalpari display brightness 80
  jalpari theme preset Sphene
  jalpari config gui
EOF
}

show_launch_help() {
    cat << 'EOF'
Usage: jalpari launch <target> [arguments...]

Available targets:
  start            Launch the start setup interface
EOF
}

show_ipc_help() {
    cat << 'EOF'
Usage: jalpari ipc call <target> <method> [arguments...]

Send an IPC call directly to the running quickshell instance.
EOF
}

VERBOSE=false

while [[ "$1" == -* ]]; do
    case "$1" in
        -v|--verbose)
            VERBOSE=true
            export JALPARI_VERBOSE=true
            shift
            ;;
        -V|--version)
            echo "jalpari v$(get_installed_version)"
            exit 0
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

if [ $# -eq 0 ]; then
    show_help
    exit 0
fi

# ==============================================================================
# MAIN ROUTING TABLE (Structured grammar + backward-compatible shorthand)
# ==============================================================================

case "$1" in
    # Structured objects (iproute2-style grammar)
    daemon)
        shift
        obj_daemon "$@"
        exit $?
        ;;
    ui|panel)
        shift
        obj_ui "$@"
        exit $?
        ;;
    system|sys)
        shift
        obj_system "$@"
        exit $?
        ;;
    audio)
        shift
        obj_audio "$@"
        exit $?
        ;;
    display)
        shift
        obj_display "$@"
        exit $?
        ;;
    theme)
        shift
        obj_theme "$@"
        exit $?
        ;;
    config)
        shift
        obj_config "$@"
        exit $?
        ;;
    env)
        shift
        obj_env "$@"
        exit $?
        ;;

    # Direct shorthand compatibility
    restart)
        shift
        restart_daemon "$@"
        exit $?
        ;;
    kill)
        shift
        stop_daemon "$@"
        echo "$(t "cli.daemon_stopped")"
        exit 0
        ;;
    reload)
        shift
        exec "$JALPARI_DIR/scripts/reload.sh" "$@"
        ;;
    msg)
        shift
        obj_ui "$@"
        exit $?
        ;;
    settings)
        shift
        exec "$JALPARI_DIR/scripts/settings.sh" "$@"
        ;;
    lock|exit|suspend|hibernate|reboot|poweroff)
        obj_system "$@"
        exit $?
        ;;
    volume)
        shift
        obj_audio volume "$@"
        exit $?
        ;;
    brightness)
        shift
        obj_display brightness "$@"
        exit $?
        ;;
    gamma)
        shift
        obj_display gamma "$@"
        exit $?
        ;;
    weather)
        shift
        obj_env weather "$@"
        exit $?
        ;;
    location)
        shift
        obj_env location "$@"
        exit $?
        ;;
    location_manual)
        shift
        obj_env location set "$@"
        exit $?
        ;;
    quickactions|qa)
        shift
        ensure_daemon
        exec "$JALPARI_DIR/scripts/qs_manager.sh" "toggle" "quickactions" "$@"
        ;;
    info)
        shift
        cli_info "$@"
        exit $?
        ;;
    set)
        shift
        cli_set "$@"
        exit $?
        ;;
    trigger)
        shift
        cli_trigger "$@"
        exit $?
        ;;
    launch)
        if [[ "$2" == "-h" || "$2" == "--help" ]]; then
            show_launch_help
            exit 0
        fi
        if [ -z "$2" ]; then
            echo "$(t "cli.error_missing_qml")"
            echo "$(t "cli.launch_usage")"
            exit 1
        fi

        TARGET="$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')"
        case "$TARGET" in
            start) QML_NAME="Start" ;;
            *)
                echo "$(t "cli.error_unknown_target" TARGET="$2")"
                show_launch_help
                exit 1
                ;;
        esac

        shift 2
        export JALPARI_LAUNCH_ARGS="$*"

        QML_FILE=$(find "$JALPARI_DIR/quickshell" -type f -name "${QML_NAME}.qml" 2>/dev/null | head -n 1)

        if [ -n "$QML_FILE" ]; then
            ensure_daemon
            export JALPARI_TARGET_FILE="$QML_FILE"
            exec quickshell -p "$JALPARI_DIR/quickshell/Runner.qml"
        else
            echo "$(t "cli.error_qml_not_found" NAME="${QML_NAME}" DIR="$JALPARI_DIR/quickshell/")"
            exit 1
        fi
        ;;
    ipc)
        if [[ "$2" == "-h" || "$2" == "--help" ]]; then
            show_ipc_help
            exit 0
        fi

        ensure_daemon

        SHELL_QML=$(find "$JALPARI_DIR/quickshell" -type f -name "Shell.qml" 2>/dev/null | head -n 1)

        if [ -z "$SHELL_QML" ] && [ -n "$MAIN_QML" ]; then
            SHELL_QML="$MAIN_QML"
        fi

        if [ -z "$SHELL_QML" ]; then
            echo "$(t "cli.error_shell_qml_not_found" DIR="$JALPARI_DIR/quickshell/")"
            exit 1
        fi

        shift
        exec quickshell -p "$SHELL_QML" ipc "$@"
        ;;
    *)
        echo "Error: unknown command or object '$1'." >&2
        show_help
        exit 1
        ;;
esac
