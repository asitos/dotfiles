{
    "allowDuplicates": false,
    "historyFile": "clipboard_history.json",
    "maxHistory": 100,
    "deleteAfter": 0,
    "logFile": "clipse.log",
    "pollInterval": 50,
    "maxEntryLength": 65,
    "themeFile": "custom_theme.json",
    "tempDir": "tmp_files",
    "keyBindings": {
        "choose": "enter",
        "clearSelected": "S",
        "down": "j, down",
        "end": "G, end",
        "filter": "/",
        "forceQuit": "Q",
        "home": "g, home",
        "more": "?",
        "nextPage": "l, right",
        "prevPage": "h, left",
        "preview": " ",
        "quit": "q, esc",
        "remove": "d, x, backspace",
        "selectDown": "J, shift+down",
        "selectSingle": "s",
        "selectUp": "K, shift+up",
        "togglePin": "p",
        "togglePinned": "tab",
        "up": "k, up",
        "yankFilter": "ctrl+s"
    },
    "imageDisplay": {
        "type": "kitty",
        "scaleX": 10,
        "scaleY": 22,
        "heightCut": 1
    },
    "excludedApps": [
        "1Password",
        "Bitwarden",
        "KeePassXC",
        "LastPass",
        "Dashlane",
        "Password Safe",
        "Keychain Access"
    ],
    "autoPaste": {
        "enabled": true,
        "keybind": "ctrl+v",
        "buffer": 10
    },
    "enableMouse": true,
    "enableDescription": true
}
